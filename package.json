{
  "name": "secor",
  "version": "1.0.0",
  "description": "Security Context Orchestrator: checks the APIs, MCP servers and websites you build, and guards your data from the MCP servers you connect.",
  "author": "Debashish Thakur",
  "homepage": "https://github.com/debashishthakur/secor#readme",
  "bugs": "https://github.com/debashishthakur/secor/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/debashishthakur/secor.git"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "application-security",
    "static-analysis",
    "secret-scanning",
    "mcp-security",
    "claude-code",
    "security",
    "sast"
  ],
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "secor": "dist/cli.js"
  },
  "files": [
    "dist",
    "grammars",
    "src/engine/templates",
    "skills",
    "hooks",
    ".claude-plugin",
    ".mcp.json",
    "DECISIONS.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.31.0",
    "commander": "15.0.0",
    "smol-toml": "1.9.0",
    "web-tree-sitter": "0.27.0",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "24.19.0",
    "tree-sitter-javascript": "0.25.0",
    "tree-sitter-python": "0.25.0",
    "tree-sitter-typescript": "0.23.2",
    "tsup": "8.5.1",
    "typescript": "7.0.2",
    "vitest": "5.0.2"
  }
}
