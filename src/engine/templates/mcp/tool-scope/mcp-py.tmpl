{{?mcp1}}        result = await client.call_tool("{{toolName}}", arguments)
{{?mcp2}}    async with Client(server) as client:
{{?mcp2}}        result = await client.call_tool("{{toolName}}", arguments)
{{?fastmcp}}    async with Client(server) as client:
{{?fastmcp}}        try:
{{?fastmcp}}            result = await client.call_tool("{{toolName}}", arguments)
{{?fastmcp}}        except ToolError:
{{?fastmcp}}            result = None
    if result is None:
        rejected, text = True, ""
    else:
        rejected = bool(getattr(result, "isError", False) or getattr(result, "is_error", False))
        text = " ".join(str(getattr(item, "text", "")) for item in (getattr(result, "content", None) or []))
    assert MARKER not in text
    assert rejected
