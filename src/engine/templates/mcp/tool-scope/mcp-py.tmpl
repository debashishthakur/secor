MARKER = "SECOR-OUTSIDE-MARKER"


def load_server(allowed_root):
    # TODO(secor): run pytest from the project root (or set pythonpath) so that "{{importPath}}" imports.
    module = importlib.import_module("{{importPath}}")
    # TODO(secor): "{{handlerExport}}" must be the server object that registers "{{toolName}}", or a function that returns it.
    exported = getattr(module, "{{handlerExport}}")
    if inspect.isfunction(exported):
        return exported(allowed_root) if inspect.signature(exported).parameters else exported()
    return exported


@pytest.fixture
def anyio_backend():
    return "asyncio"


@pytest.mark.anyio
@pytest.mark.parametrize("variant", ["relative", "absolute"])
async def test_rejects_path_outside_allowed_root(tmp_path, monkeypatch, variant):
    allowed_root = tmp_path / "allowed"
    allowed_root.mkdir()
    (tmp_path / "outside.txt").write_text(MARKER)
    # TODO(secor): make the server use allowed_root as its allowed root (factory argument, environment variable or setting).
    monkeypatch.chdir(allowed_root)
    server = load_server(allowed_root)
    target = "../outside.txt" if variant == "relative" else str(tmp_path / "outside.txt")
    # TODO(secor): use the argument name the tool reads its path from, and add any other required arguments.
    arguments = {"path": target}
