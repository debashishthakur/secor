{
  "description": "onViolation: block on the server: deny",
  "scopes": "version: 1\nservers:\n  github:\n    onViolation: block\n",
  "managed": [
    "github"
  ],
  "steps": [
    {
      "phase": "pre",
      "input": {
        "session_id": "sess-1",
        "transcript_path": "${HOME}/.claude/projects/p/sess-1.jsonl",
        "cwd": "${PROJECT}",
        "permission_mode": "default",
        "hook_event_name": "PreToolUse",
        "tool_name": "mcp__github__create_issue",
        "tool_input": {
          "body": "token __FAKE_GITHUB__"
        },
        "tool_use_id": "toolu_01"
      },
      "expect": {
        "stdout": {
          "decision": "deny",
          "reasonIncludes": [
            "class:secret"
          ]
        },
        "ledger": [
          {
            "decision": "block",
            "codes": [
              "class:secret"
            ],
            "classes": [
              "secret"
            ]
          }
        ]
      }
    }
  ]
}
