{
  "description": "A secret in the arguments: ask with class:secret",
  "scopes": "version: 1\nservers:\n  github:\n    tools: [search_code, create_issue]\n",
  "managed": [
    "github"
  ],
  "steps": [
    {
      "phase": "pre",
      "input": {
        "session_id": "sess-1",
        "transcript_path": "${HOME}/.claude/projects/p/sess-1.jsonl",
        "cwd": "${PROJECT}",
        "permission_mode": "default",
        "hook_event_name": "PreToolUse",
        "tool_name": "mcp__github__create_issue",
        "tool_input": {
          "repo": "acme/app",
          "title": "Rotate",
          "body": "Our key is __FAKE_OPENAI__ please rotate"
        },
        "tool_use_id": "toolu_01"
      },
      "expect": {
        "stdout": {
          "hookSpecificOutput": {
            "hookEventName": "PreToolUse",
            "permissionDecision": "ask",
            "permissionDecisionReason": "SECOR: class:secret (arguments contain a secret (OpenAI key))"
          }
        },
        "ledger": [
          {
            "decision": "ask",
            "codes": [
              "class:secret"
            ],
            "classes": [
              "secret"
            ]
          }
        ]
      }
    }
  ]
}
