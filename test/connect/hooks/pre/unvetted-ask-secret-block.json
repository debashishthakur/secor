{
  "description": "unvetted uses defaults.unvetted (ask), the class reason uses onViolation (block): block wins",
  "scopes": "version: 1\ndefaults:\n  onViolation: block\n  unvetted: ask\n",
  "steps": [
    {
      "phase": "pre",
      "input": {
        "session_id": "sess-1",
        "transcript_path": "${HOME}/.claude/projects/p/sess-1.jsonl",
        "cwd": "${PROJECT}",
        "permission_mode": "default",
        "hook_event_name": "PreToolUse",
        "tool_name": "mcp__random__lookup",
        "tool_input": {
          "q": "__FAKE_AWS_ACCESS_KEY__"
        },
        "tool_use_id": "toolu_01"
      },
      "expect": {
        "stdout": {
          "decision": "deny",
          "reasonIncludes": [
            "unvetted",
            "class:secret"
          ]
        },
        "ledger": [
          {
            "decision": "block",
            "codes": [
              "unvetted",
              "class:secret"
            ]
          }
        ]
      }
    }
  ]
}
