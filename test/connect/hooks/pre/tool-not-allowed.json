{
  "description": "Tool outside the scope's allowlist: ask tool-not-allowed",
  "scopes": "version: 1\nservers:\n  github:\n    tools: [search_code]\n",
  "managed": [
    "github"
  ],
  "steps": [
    {
      "phase": "pre",
      "input": {
        "session_id": "sess-1",
        "transcript_path": "${HOME}/.claude/projects/p/sess-1.jsonl",
        "cwd": "${PROJECT}",
        "permission_mode": "default",
        "hook_event_name": "PreToolUse",
        "tool_name": "mcp__github__delete_repo",
        "tool_input": {
          "repo": "acme/app"
        },
        "tool_use_id": "toolu_01"
      },
      "expect": {
        "stdout": {
          "decision": "ask",
          "reasonIncludes": [
            "tool-not-allowed"
          ]
        },
        "ledger": [
          {
            "decision": "ask",
            "tool": "delete_repo",
            "codes": [
              "tool-not-allowed"
            ]
          }
        ]
      }
    }
  ]
}
