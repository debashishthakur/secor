{
  "description": "A path through a symlinked directory into ~/.secor",
  "steps": [
    {
      "phase": "protect",
      "input": {
        "session_id": "sess-1",
        "transcript_path": "${HOME}/.claude/projects/p/sess-1.jsonl",
        "cwd": "${PROJECT}",
        "permission_mode": "default",
        "hook_event_name": "PreToolUse",
        "tool_name": "Write",
        "tool_input": {
          "file_path": "${PROJECT}/cfg/servers.json",
          "content": "x"
        },
        "tool_use_id": "toolu_01"
      },
      "expect": {
        "stdout": {
          "hookSpecificOutput": {
            "hookEventName": "PreToolUse",
            "permissionDecision": "deny",
            "permissionDecisionReason": "SECOR policy files are edited by humans only. Ask the user to make this change."
          }
        },
        "ledger": []
      }
    }
  ],
  "files": {
    "${SECOR_HOME}/servers.json": "{\"version\":1,\"servers\":{}}\n"
  },
  "symlinks": {
    "${PROJECT}/cfg": "${SECOR_HOME}"
  }
}
